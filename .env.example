# Retell
RETELL_API_KEY=
RETELL_BASE_URL=https://api.retellai.com
ALLOW_PUBLISH=false          # safety switch. Rey flips it by hand.

# n8n
N8N_BASE_URL=
N8N_API_KEY=

# Make
MAKE_API_TOKEN=
MAKE_ZONE=                   # e.g. us1.make.com
MAKE_TEAM_ID=

# GoHighLevel
GHL_API_KEY=                 # private integration token
GHL_LOCATION_ID=

# HubSpot
HUBSPOT_PRIVATE_APP_TOKEN=

# Zapier
ZAPIER_WEBHOOK_URL=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Calendars
CALCOM_API_KEY=
GOOGLE_CALENDAR_CREDENTIALS_PATH=   # path to a JSON file outside both repos

# LLM providers, for tools that call a model outside Retell
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Webhook signing secrets
WEBHOOK_SIGNING_SECRET=
