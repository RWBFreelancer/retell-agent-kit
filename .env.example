# retell-agent-kit credentials. Copy to .env (git-ignored) and fill in.
# Never commit .env. Never paste a value into chat or a file that is committed.
#
# MANY ACCOUNTS PER SERVICE
#   Give every key an account suffix:  KEY__<ACCOUNT>=value
#   Pick the account with a selector:  <SERVICE>_ACCOUNT=<account>
#   The selected account's keys become the plain names every tool reads.
#   Default selectors live here. A client overrides them in
#   <client>/.env.local:   python tools/accounts.py use --client acme retell=acme
#   One-off in PowerShell:  $env:N8N_ACCOUNT='acme'; python kit/n8nkit.py ping
#   With one account defined and no selector, that account is used.
#   Full rules: kit/accounts.py.   Check: python tools/accounts.py list
#
# Add an account:  python tools/accounts.py template n8n acme   (prints the lines)
# Values below are placeholders. Replace ACME / MAIN with real account names.

# ---------------------------------------------------------------- selectors
RETELL_ACCOUNT=
N8N_ACCOUNT=
MAKE_ACCOUNT=
MODAL_ACCOUNT=

# ---------------------------------------------------------------- shared
RETELL_BASE_URL=https://api.retellai.com
# Safety switch for publishkit.py. Leave false. Flip by hand for one publish.
ALLOW_PUBLISH=false

# ---------------------------------------------------------------- Retell
# Dashboard > Settings > API Keys. One per workspace.
RETELL_API_KEY__ACME=

# ---------------------------------------------------------------- n8n
# REST API: n8n Settings > n8n API > Create an API key.
# MCP: n8n Settings > Instance-level MCP (a different token). Used by tools/mcpgen.py.
N8N_BASE_URL__ACME=https://acme.app.n8n.cloud
N8N_API_KEY__ACME=
N8N_MCP_URL__ACME=https://acme.app.n8n.cloud/mcp-server/http
N8N_MCP_TOKEN__ACME=

# ---------------------------------------------------------------- Make
# API: Profile > API access > Add token. Zone is the org's host (eu1.make.com, us1.make.com, ...).
# MCP token: Profile > API access > MCP token. Used by tools/mcpgen.py.
MAKE_API_TOKEN__MAIN=
MAKE_ZONE__MAIN=eu1.make.com
MAKE_TEAM_ID__MAIN=
MAKE_MCP_TOKEN__MAIN=

# ---------------------------------------------------------------- Modal
# modal.com > Settings > API Tokens. Read by kit/modalkit.py, passed to the modal CLI.
MODAL_TOKEN_ID__MAIN=
MODAL_TOKEN_SECRET__MAIN=
MODAL_ENVIRONMENT__MAIN=main

# ---------------------------------------------------------------- other connected apps
# Same KEY__ACCOUNT pattern works for each (selector: GHL_ACCOUNT, HUBSPOT_ACCOUNT, ...).
GHL_API_KEY__ACME=
GHL_LOCATION_ID__ACME=
HUBSPOT_PRIVATE_APP_TOKEN__ACME=
ZAPIER_WEBHOOK_URL__ACME=
TWILIO_ACCOUNT_SID__ACME=
TWILIO_AUTH_TOKEN__ACME=
CALCOM_API_KEY__ACME=
# A path to a service-account JSON kept outside every repo.
GOOGLE_CALENDAR_CREDENTIALS_PATH__ACME=

# ---------------------------------------------------------------- LLM providers
# For tools that call a model outside Retell.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ---------------------------------------------------------------- webhook signing
# Shared secret for receivers that are not Retell (Retell signs with the API key).
WEBHOOK_SIGNING_SECRET=
